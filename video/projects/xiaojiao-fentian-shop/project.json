        "min_seconds": 2.8,
        "max_seconds": 3.2
      }
    },
    "final": {
      "argv": [
        "python",
        "ninja/video/projects/xiaojiao-fentian-shop/render.py",
        "--output",
        "{output}"
      ],
      "output": "output/{id}-final.mp4",
      "timeout_seconds": 2400,
      "checks": {
        "audio_required": true,
        "min_seconds": 22.3,
