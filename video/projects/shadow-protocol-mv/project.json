{
  "schema_version": "1",
  "id": "shadow-protocol-mv",
  "title": "历史样片：SHADOW PROTOCOL 音乐混剪",
  "kind": "music-video",
  "role": "example-only",
  "notes": "使用另一个完全独立的节奏剪辑渲染器。没有对话框模板；仅供理解项目如何配置，不预设后续 MV 风格。",
  "required_files": [
    "ninja/mv/make_mv.py",
    "music/music/game-ost/jrpg-epic-rock-full.mp3",
    "ninja/assets/backgrounds/wallpaper_rooftop_01.jpg",
    "ninja/assets/characters/blood_shadow_01.png"
  ],
  "render": {
    "preview": {
      "argv": [
        "python",
        "ninja/mv/make_mv.py",
        "--seconds",
        "2",
        "--output",
        "{output}"
      ],
      "output": "output/{id}-preview.mp4",
      "checks": {
        "audio_required": true,
        "min_seconds": 1.8,
        "max_seconds": 2.25
      }
    },
    "final": {
      "argv": [
        "python",
        "ninja/mv/make_mv.py",
        "--output",
        "{output}"
      ],
      "output": "output/{id}-final.mp4",
      "checks": {
        "audio_required": true,
        "min_seconds": 47,
        "max_seconds": 49,
        "min_width": 1280,
        "min_height": 720
      }
    }
  }
}
